{
  "name": "licenseathon-vue",
  "version": "1.0.0",
  "description": "Layouts for Licenseathon 2023",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tempystral/licenseathon-2023"
  },
  "license": "MIT",
  "author": "tempystral",
  "scripts": {
    "autofix": "run-s autofix:*",
    "autofix:browser": "eslint --fix --ext .ts,.vue src/dashboard && eslint --fix --ext .ts,.vue src/graphics",
    "autofix:extension": "eslint --fix --ext .ts src/extension && eslint --fix --ext .d.ts src/types",
    "build": "run-s clean build:*",
    "build:browser": "vite build",
    "build:extension": "tsc -b tsconfig.extension.json",
    "clean": "rm -rf node_modules/.cache dashboard graphics extension shared/dist",
    "schema-types": "nodecg schema-types",
    "start": "nodecg start",
    "watch": "run-p watch:*",
    "watch:browser": "vite",
    "watch:extension": "tsc -b tsconfig.extension.json -w"
  },
  "dependencies": {
    "@jamescoyle/vue-icon": "^0.1.2",
    "@mdi/js": "^7.4.47",
    "@primeuix/themes": "^2.0.3",
    "fitty": "^2.4.2",
    "iframe-resizer": "^5.5.9",
    "module-alias": "^2.3.4",
    "nodecg": "^2.8.0",
    "nodecg-vue-composable": "link:~/git/nodecg-vue-composable",
    "tailwindcss": "^4.3.2",
    "tailwindcss-primeui": "^0.6.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nodecg/types": "^2.8.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/textfit": "^2.4.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vueuse/head": "^2.0.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "globby": "^16.2.0",
    "npm-run-all": "^4.1.5",
    "primevue": "^4.5.5",
    "sass": "^1.101.0",
    "speedcontrol-util": "^0.6.1",
    "trash-cli": "^7.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-plugin-checker": "^0.14.4",
    "vite-plugin-nodecg": "^2.1.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-inline-svg": "^4.0.1",
    "vue-tsc": "^3.3.6"
  },
  "nodecg": {
    "compatibleRange": "^2.5.3",
    "bundleDependencies": {
      "nodecg-speedcontrol": "^2.5.0"
    },
    "soundCues": [
      {
        "name": "credits-music",
        "defaultVolume": 100,
        "defaultFile": "assets/sound/budokai-music-edited.mp3"
      }
    ],
    "assetCategories": [
      {
        "name": "images",
        "title": "Images",
        "allowedTypes": [
          "jpg",
          "jpeg",
          "gif",
          "png",
          "svg"
        ]
      }
    ],
    "dashboardPanels": [
      {
        "name": "commentator-panel",
        "title": "Commentators",
        "file": "commentatorPanel.html",
        "width": 3
      },
      {
        "name": "credits-panel",
        "title": "Credits",
        "file": "creditsPanel.html",
        "width": 3
      }
    ],
    "graphics": [
      {
        "file": "splash.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "setup.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "credits.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "solo_16_9.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "solo_4_3.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "race_4_3.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "race_3_way.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "race_bingo.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "solo_GBA.html",
        "width": 1920,
        "height": 1080
      }
    ]
  }
}
